{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/bundle.js", "dest": "/bundle.js" },
    { "src": "/bundle.css", "dest": "/bundle.css" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/login_bg_official.jpg", "dest": "/login_bg_official.jpg" },
    { "src": "/db.json", "dest": "/db.json" },
    { "src": "/assets/logo.png", "dest": "/logo.png" },
    { "src": "/assets/login_bg_official.jpg", "dest": "/login_bg_official.jpg" },
    { "src": "/assets/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}